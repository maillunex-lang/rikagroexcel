{
  "name": "rikagroexcel",
  "version": "2.4.0",
  "private": true,
  "description": "Прайс-мост Portable",
  "main": "desktop/main.js",
  "scripts": {
    "check": "node --check desktop/main.js && node --check dist/app.js && node --check dist/engine.js",
    "dist:win": "electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "ru.rikagro.pricebridge",
    "productName": "Прайс-мост",
    "asar": true,
    "files": [
      "desktop/**/*",
      "dist/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Price-Bridge-${version}-Portable.${ext}"
    }
  }
}
